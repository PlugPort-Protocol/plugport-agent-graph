# Copy to .env and fill in. Never commit .env.

# --- PlugPort (storage) ---
# Base URL of the PlugPort HTTP API (no trailing slash), e.g. the testnet deployment
PLUGPORT_URL=http://localhost:8080
# Wallet API key generated in the PlugPort dashboard (sent as the x-api-key header)
PLUGPORT_API_KEY=
# Optional: a second wallet's key, for the graph-sharing demo
PLUGPORT_API_KEY_2=
# Graph name inside the wallet's namespace ("default" -> collections mem_nodes / mem_edges / mem_anchors)
PAG_GRAPH=default

# --- Monad (anchoring, Phase 2) ---
MONAD_RPC_URL=
# Private key of a faucet-funded testnet wallet that pays for anchor transactions
ANCHOR_PRIVATE_KEY=
# Address of the deployed MemoryAnchor contract
ANCHOR_CONTRACT=
# Block explorer base URL for tx links, e.g. https://<explorer>/tx/
EXPLORER_TX_URL=

# --- Demo agent (Phase 3): Gemma via Google AI Studio (Gemini API) ---
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemma model id on the Gemini API
GEMMA_MODEL=gemma-4-31b-it
