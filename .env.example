# Copy to .env and fill in. Never commit .env.

# --- PlugPort (storage) ---
# Base URL of the PlugPort HTTP API (no trailing slash), e.g. the testnet deployment
PLUGPORT_URL=http://localhost:8080
# Wallet API key generated in the PlugPort dashboard (sent as the x-api-key header)
PLUGPORT_API_KEY=
# Required for `pnpm demo --share` (cross-wallet graph sharing, PLAN.md step 6).
# Generate from a second wallet in the PlugPort dashboard, then share wallet-1's
# graph with wallet-2 via the PlugPort ACL (grantRole) before running the demo.
PLUGPORT_API_KEY_2=
# Graph name inside the wallet's namespace ("default" -> collections mem_nodes / mem_edges / mem_anchors)
PAG_GRAPH=default

# --- Monad (anchoring, Phase 2) ---
MONAD_RPC_URL=
# Private key of a faucet-funded testnet wallet that pays for anchor transactions
ANCHOR_PRIVATE_KEY=
# Address of the deployed MemoryAnchor contract
ANCHOR_CONTRACT=
# Block explorer base URL for tx links, e.g. https://<explorer>/tx/
EXPLORER_TX_URL=

# --- Demo agent (Phase 3): Gemma via Google AI Studio (Gemini API) ---
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemma model id on the Gemini API
GEMMA_MODEL=gemma-4-31b-it

# --- Web viewer (Phase 5) ---
# Public address of the anchor wallet; verify only trusts roots it anchored. Never put the private key in the viewer's env.
ANCHOR_ADDRESS=
# true lets the viewer edit a memory directly in PlugPort to demo tamper detection (writes, costs gas)
VIEWER_ALLOW_TAMPER=false
# Optional: require this password (HTTP basic auth, any username) to open the viewer
VIEWER_PASSWORD=
